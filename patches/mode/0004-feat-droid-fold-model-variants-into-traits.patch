+function buildDroidModelOptionDescriptors(
+  models: ReadonlyArray<AvailableModelConfig>,
+  defaultModel: AvailableModelConfig,
+) {
+  const seenEfforts = new Set<string>();
+  const reasoningOptions = models.flatMap((model) =>
+    model.supportedReasoningEfforts.flatMap((effort) => {
+      if (seenEfforts.has(effort)) {
+        return [];
+      }
+      seenEfforts.add(effort);
+      return [
+        {
+          value: effort,
+          label: REASONING_EFFORT_LABELS[effort] ?? effort,
+          isDefault: effort === defaultModel.defaultReasoningEffort,
+        },
+      ];
+    }),
+  );
+  if (reasoningOptions.length === 0) {
+    return [];
+  }
+  return [
+    buildSelectOptionDescriptor({
+      id: "reasoningEffort",
+      label: "Reasoning",
+      options: reasoningOptions,
+    }),
+  ];
+}
+
+function droidModelGroupCapabilities(group: DroidModelGroup, defaultModel: ResolvedDroidModel) {
+  const variantOptions = uniqueDroidVariantOptions(group.models, defaultModel.slug);
+  return createModelCapabilities({
+    optionDescriptors: [
+      ...buildDroidModelOptionDescriptors(
+        group.models.map((model) => model.source),
+        defaultModel.source,
+      ),
+      buildSelectOptionDescriptor({
+        id: DROID_MODEL_VARIANT_OPTION_ID,
+        label: "Variant",
+        options: variantOptions,
+      }),
+    ],
+  });
+}
+
+function uniqueDroidVariantOptions(models: ReadonlyArray<ResolvedDroidModel>, defaultSlug: string) {
+  const labelCounts = new Map<string, number>();
+  for (const model of models) {
+    const label = model.variantLabel ?? "Standard";
+    labelCounts.set(label, (labelCounts.get(label) ?? 0) + 1);
+  }
+
+  return models.map((model) => {
+    const label = model.variantLabel ?? "Standard";
+    const uniqueLabel =
+      (labelCounts.get(label) ?? 0) > 1 ? `${label} (${model.shortName ?? model.name})` : label;
+    return {
+      value: model.slug,
+      label: uniqueLabel,
+      isDefault: model.slug === defaultSlug,
+    };
+  });
+}
+
+function splitDroidVariantName(name: string): {
+  readonly baseName: string;
+  readonly variantLabel: string | undefined;
+} {
+  let baseName = normalizeModelName(name);
+  const labels: string[] = [];
+  for (;;) {
+    const parenthetical = baseName.match(/^(?<base>.+?)\s+\((?<suffix>[^)]+)\)$/);
+    if (parenthetical?.groups) {
+      const { base, suffix: rawSuffix } = parenthetical.groups;
+      const suffix = rawSuffix ? droidVariantLabel(rawSuffix) : undefined;
+      if (base && suffix) {
+        baseName = normalizeModelName(base);
+        labels.unshift(suffix);
+        continue;
+      }
+    }
+
+    const fast = baseName.match(/^(?<base>.+?)[\s-]+fast$/i);
+    if (fast?.groups?.base) {
+      baseName = normalizeModelName(fast.groups.base);
+      labels.unshift("Fast");
+      continue;
+    }
+
+    const context = baseName.match(
+      /^(?<base>.+?)[\s-]+(?<size>\d+(?:\.\d+)?\s*(?:k|m)|\d+(?:\.\d+)?\s*million)(?:\s+(?:token\s*)?(?:context(?:\s+window)?|ctx))?$/i,
+    );
+    if (context?.groups?.base && context.groups.size) {
+      baseName = normalizeModelName(context.groups.base);
+      labels.unshift(`${formatContextWindowLabel(context.groups.size)} Context`);
+      continue;
+    }
+
+    break;
+  }
+
+  return {
+    baseName,
+    variantLabel: labels.length > 0 ? labels.join(" · ") : undefined,
+  };
+}
+
+function droidVariantLabel(value: string): string | undefined {
+  const normalized = normalizeModelName(value);
+  if (/^fast$/i.test(normalized)) {
+    return "Fast";
+  }
+  const context = normalized.match(
+    /^(?<size>\d+(?:\.\d+)?\s*(?:k|m)|\d+(?:\.\d+)?\s*million)(?:\s+(?:token\s*)?(?:context(?:\s+window)?|ctx))?$/i,
+  );
+  if (context?.groups?.size) {
+    return `${formatContextWindowLabel(context.groups.size)} Context`;
+  }
+  return undefined;
+}
+
+function formatContextWindowLabel(value: string): string {
+  const compact = normalizeModelName(value);
+  const million = compact.match(/^(?<amount>\d+(?:\.\d+)?)\s*million$/i);
+  if (million?.groups) {
+    return `${million.groups.amount}M`;
+  }
+  return compact.replace(/\s+/g, "").replace(/[km]$/i, (unit) => unit.toUpperCase());
+}
+
+function normalizeModelName(value: string): string {
+  return value.replace(/_+/g, " ").replace(/\s+/g, " ").trim();
+}
+
+function resolveDroidModel(model: AvailableModelConfig): ResolvedDroidModel | null {
+  const slug = droidModelSlug(model);
+  if (!slug) return null;
+  const name = nonEmpty(model.displayName) ?? slug;
+  const shortName = nonEmpty(model.shortDisplayName);
+  const parsedName = splitDroidVariantName(name);
+  const parsedShortName = shortName ? splitDroidVariantName(shortName) : undefined;
+  const baseShortName = parsedShortName?.baseName || shortName;
+  const variantLabel = parsedShortName?.variantLabel ?? parsedName.variantLabel;
+  return {
+    source: model,
+    slug,
+    name,
+    ...(shortName ? { shortName } : {}),
+    baseName: parsedName.baseName || name,
+    ...(baseShortName ? { baseShortName } : {}),
+    ...(variantLabel ? { variantLabel } : {}),
+  };
+}
+
+function droidModelSlug(model: AvailableModelConfig): string | undefined {
+  return model.isCustom
     ? (nonEmpty(model.id) ?? nonEmpty(model.modelId))
     : (nonEmpty(model.modelId) ?? nonEmpty(model.id));
+}
+
+function droidModelGroupKey(model: ResolvedDroidModel): string {
+  if (model.source.isCustom) {
+    return `slug:${model.slug}`;
+  }
+  return ["variant", model.source.modelProvider, model.baseName.toLowerCase()].join(":");
+}
+
+function droidGroupedModelToServerModel(group: DroidModelGroup): ServerProviderModel | null {
+  const firstModel = group.models[0];
+  if (!firstModel) {
+    return null;
+  }
+  if (group.models.length === 1) {
+    return droidAvailableModelToServerModel(firstModel.source);
+  }
+
+  const defaultModel = group.models.find((model) => !model.variantLabel) ?? firstModel;
+  return {
+    slug: defaultModel.slug,
+    name: defaultModel.baseName,
+    ...(defaultModel.baseShortName && defaultModel.baseShortName !== defaultModel.baseName
+      ? { shortName: defaultModel.baseShortName }
+      : {}),
+    subProvider: modelProviderLabel(defaultModel.source.modelProvider),
+    isCustom: defaultModel.source.isCustom,
+    capabilities: droidModelGroupCapabilities(group, defaultModel),
+  };
+}
+
+function droidAvailableModelToServerModel(model: AvailableModelConfig): ServerProviderModel | null {
+  const slug = droidModelSlug(model);
   if (!slug) return null;
   const name = nonEmpty(model.displayName) ?? slug;
   const shortName = nonEmpty(model.shortDisplayName);
@@ -173,17 +366,29 @@ const nonEmpty = (value: string | undefined): string | undefined => {
