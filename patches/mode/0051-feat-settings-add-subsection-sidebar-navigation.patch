       <SidebarSeparator />
@@ -114,7 +207,7 @@ export function SettingsSidebarNav({ pathname }: { pathname: string }) {
                 className="gap-2 px-2 py-2 text-xs text-muted-foreground hover:bg-accent hover:text-foreground"
                 onClick={handleBackClick}
