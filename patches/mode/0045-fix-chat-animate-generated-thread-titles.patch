diff --git a/apps/web/src/components/AnimatedThreadTitle.tsx b/apps/web/src/components/AnimatedThreadTitle.tsx
new file mode 100644
index 00000000..7356fd54
--- /dev/null
+++ b/apps/web/src/components/AnimatedThreadTitle.tsx
@@ -0,0 +1,69 @@
+import { useEffect, useLayoutEffect, useState } from "react";
+import type { SlotOptions } from "slot-text";
+import { SlotText } from "slot-text/react";
+import { resolveVisibleThreadTitle, shouldAnimateThreadTitleAppearance } from "../threadTitle";
+
+const THREAD_TITLE_SLOT_OPTIONS = {
+  direction: "up",
+  stagger: 8,
+  duration: 240,
+  exitOffset: 12,
+  bounce: 0.05,
+  skipUnchanged: true,
+} satisfies SlotOptions;
+
+const useBrowserLayoutEffect = typeof window === "undefined" ? useEffect : useLayoutEffect;
+const HIDDEN_THREAD_TITLE_SLOT_TEXT = " ";
+
+function resolveThreadTitleSlotText(visibleTitle: string): string {
+  return visibleTitle || HIDDEN_THREAD_TITLE_SLOT_TEXT;
+}
+
+function buildHiddenThreadTitleSlotText(nextVisibleTitle: string): string {
+  return " ".repeat(Math.max(1, nextVisibleTitle.length));
+}
+
+interface AnimatedThreadTitleProps {
+  readonly titleKey: string;
+  readonly title: string;
+  readonly className?: string;
+}
+
+export function AnimatedThreadTitle({ titleKey, title, className }: AnimatedThreadTitleProps) {
+  return (
+    <AnimatedThreadTitleContent
+      key={titleKey}
+      title={title}
+      {...(className !== undefined ? { className } : {})}
+    />
+  );
+}
+
+function AnimatedThreadTitleContent({
+  title,
+  className,
+}: Omit<AnimatedThreadTitleProps, "titleKey">) {
+  const visibleTitle = resolveVisibleThreadTitle(title);
+  const nextSlotTitle = resolveThreadTitleSlotText(visibleTitle);
+  const [slotTitle, setSlotTitle] = useState(nextSlotTitle);
+
+  useBrowserLayoutEffect(() => {
+    if (slotTitle === nextSlotTitle) {
+      return;
+    }
+    if (!shouldAnimateThreadTitleAppearance({ displayedTitle: slotTitle, nextTitle: title })) {
+      setSlotTitle(nextSlotTitle);
+      return;
+    }
+    const placeholderTitle = buildHiddenThreadTitleSlotText(visibleTitle);
+    if (slotTitle !== placeholderTitle) {
+      setSlotTitle(placeholderTitle);
+    }
+    const frameId = window.requestAnimationFrame(() => {
+      setSlotTitle(nextSlotTitle);
+    });
+    return () => window.cancelAnimationFrame(frameId);
+  }, [nextSlotTitle, slotTitle, title, visibleTitle]);
+
+  return <SlotText className={className} options={THREAD_TITLE_SLOT_OPTIONS} text={slotTitle} />;
+}
