diff --git a/apps/web/src/threadTitle.test.ts b/apps/web/src/threadTitle.test.ts
new file mode 100644
index 00000000..3fe3781e
--- /dev/null
+++ b/apps/web/src/threadTitle.test.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { DEFAULT_THREAD_TITLE, shouldAnimateThreadTitleAppearance } from "./threadTitle";
+
+describe("shouldAnimateThreadTitleAppearance", () => {
+  it("animates when a hidden thread title becomes visible", () => {
+    expect(
+      shouldAnimateThreadTitleAppearance({
+        displayedTitle: "",
+        nextTitle: "Generated title",
+      }),
+    ).toBe(true);
+  });
+
+  it("animates when a whitespace placeholder becomes visible", () => {
+    expect(
+      shouldAnimateThreadTitleAppearance({
+        displayedTitle: "   ",
+        nextTitle: "Generated title",
+      }),
+    ).toBe(true);
+  });
+
+  it("does not animate title replacements that are already visible", () => {
+    expect(
+      shouldAnimateThreadTitleAppearance({
+        displayedTitle: "Existing title",
+        nextTitle: "Different title",
+      }),
+    ).toBe(false);
+  });
+
+  it("does not animate the default hidden title", () => {
+    expect(
+      shouldAnimateThreadTitleAppearance({
+        displayedTitle: "",
+        nextTitle: DEFAULT_THREAD_TITLE,
+      }),
+    ).toBe(false);
+  });
+});
diff --git a/apps/web/src/threadTitle.ts b/apps/web/src/threadTitle.ts
new file mode 100644
index 00000000..c683e89c
--- /dev/null
+++ b/apps/web/src/threadTitle.ts
@@ -0,0 +1,48 @@
+import { create } from "zustand";
+
+export const DEFAULT_THREAD_TITLE = "New thread";
+
+export function resolveVisibleThreadTitle(title: string): string {
+  const trimmedTitle = title.trim();
+  return trimmedTitle === DEFAULT_THREAD_TITLE ? "" : title;
+}
+
+export function shouldAnimateThreadTitleAppearance(input: {
+  readonly displayedTitle: string;
+  readonly nextTitle: string;
+}): boolean {
+  return (
+    input.displayedTitle.trim().length === 0 &&
+    resolveVisibleThreadTitle(input.nextTitle).trim().length > 0
+  );
+}
+
+interface ThreadTitleFallbackState {
+  readonly titleByThreadKey: Record<string, string | undefined>;
+  readonly setThreadTitleFallback: (threadKey: string, title: string) => void;
+  readonly clearThreadTitleFallback: (threadKey: string) => void;
+}
+
+export const useThreadTitleFallbackStore = create<ThreadTitleFallbackState>((set) => ({
+  titleByThreadKey: {},
+  setThreadTitleFallback: (threadKey, title) =>
+    set((state) => ({
+      titleByThreadKey: {
+        ...state.titleByThreadKey,
+        [threadKey]: title,
+      },
+    })),
+  clearThreadTitleFallback: (threadKey) =>
+    set((state) => {
+      const { [threadKey]: _removed, ...titleByThreadKey } = state.titleByThreadKey;
+      return { titleByThreadKey };
+    }),
+}));
+
+export function resolveSidebarThreadTitle(input: {
+  readonly title: string;
+  readonly fallbackTitle: string | undefined;
+}): string {
+  const visibleTitle = resolveVisibleThreadTitle(input.title);
+  return visibleTitle || input.fallbackTitle || "";
+}
