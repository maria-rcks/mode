@@ -0,0 +1,73 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  filterSettingsNavCategories,
+  getFirstSettingsNavSearchTarget,
+  normalizeSettingsSearchQuery,
+} from "./SettingsSidebarNav.logic";
+
+const categories = [
+  {
+    label: "General",
+    to: "/settings/general",
+    subItems: [
+      { label: "Theme", anchor: "theme" },
+      { label: "Time format", anchor: "time-format" },
+    ],
+  },
+  {
+    label: "Source Control",
+    to: "/settings/source-control",
+    subItems: [
+      { label: "Version Control", anchor: "version-control" },
+      { label: "Source Control Providers", anchor: "source-control-providers" },
+    ],
+  },
+  { label: "Providers", to: "/settings/providers" },
+] as const;
+
+describe("SettingsSidebarNav logic", () => {
+  it("normalizes repeated whitespace and casing", () => {
+    expect(normalizeSettingsSearchQuery("  Source   Control  ")).toBe("source control");
+  });
+
+  it("returns all categories when the query is empty", () => {
+    expect(filterSettingsNavCategories(categories, " ")).toEqual(categories);
+  });
+
+  it("keeps only matching sub-items when the category label does not match", () => {
+    expect(filterSettingsNavCategories(categories, "theme")).toEqual([
+      {
+        label: "General",
+        to: "/settings/general",
+        subItems: [{ label: "Theme", anchor: "theme" }],
+      },
+    ]);
+  });
+
+  it("keeps all sub-items when the category label matches", () => {
+    expect(filterSettingsNavCategories(categories, "source")).toEqual([
+      {
+        label: "Source Control",
+        to: "/settings/source-control",
+        subItems: [
+          { label: "Version Control", anchor: "version-control" },
+          { label: "Source Control Providers", anchor: "source-control-providers" },
+        ],
+      },
+    ]);
+  });
+
+  it("targets the first matching category for Enter navigation", () => {
+    expect(getFirstSettingsNavSearchTarget(categories, "source")).toEqual({
+      to: "/settings/source-control",
+    });
+  });
+
+  it("targets the first matching sub-item when the category label does not match", () => {
+    expect(getFirstSettingsNavSearchTarget(categories, "version control")).toEqual({
+      to: "/settings/source-control",
+      anchor: "version-control",
+    });
+  });
+});
