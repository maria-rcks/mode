+
+  if (input.isSelected) {
+    return cn(
+      baseClassName,
+      "via-primary/15 to-primary/15 group-hover/menu-sub-item:via-primary/19 group-hover/menu-sub-item:to-primary/19 group-focus-within/menu-sub-item:via-primary/19 group-focus-within/menu-sub-item:to-primary/19 dark:via-primary/22 dark:to-primary/22 dark:group-hover/menu-sub-item:via-primary/28 dark:group-hover/menu-sub-item:to-primary/28 dark:group-focus-within/menu-sub-item:via-primary/28 dark:group-focus-within/menu-sub-item:to-primary/28",
+    );
+  }
+
+  if (input.isActive) {
+    return cn(
+      baseClassName,
+      "via-accent/85 to-accent/85 group-hover/menu-sub-item:via-accent group-hover/menu-sub-item:to-accent group-focus-within/menu-sub-item:via-accent group-focus-within/menu-sub-item:to-accent dark:via-accent/55 dark:to-accent/55 dark:group-hover/menu-sub-item:via-accent/70 dark:group-hover/menu-sub-item:to-accent/70 dark:group-focus-within/menu-sub-item:via-accent/70 dark:group-focus-within/menu-sub-item:to-accent/70",
+    );
+  }
+
+  return cn(
+    baseClassName,
+    "via-sidebar to-sidebar group-hover/menu-sub-item:via-accent group-hover/menu-sub-item:to-accent group-focus-within/menu-sub-item:via-accent group-focus-within/menu-sub-item:to-accent",
