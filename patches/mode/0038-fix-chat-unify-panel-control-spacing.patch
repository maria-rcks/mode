+function visibleChildRects(element: Element): DOMRect[] {
+  return Array.from(element.children)
+    .map((child) => child.getBoundingClientRect())
+    .filter((rect) => rect.width > 0 && rect.height > 0);
+}
+
+function expectUniformVisibleChildGaps(element: HTMLElement): void {
+  const rects = visibleChildRects(element);
+  expect(rects.length).toBeGreaterThan(1);
+  const expectedGap = Number.parseFloat(window.getComputedStyle(element).columnGap);
+  const gaps = rects.slice(1).map((rect, index) => rect.left - rects[index]!.right);
+  expect(gaps.every((gap) => Math.abs(gap - expectedGap) <= 1)).toBe(true);
+}
