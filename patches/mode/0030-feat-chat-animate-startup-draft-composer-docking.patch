+  const dockStartupDraftComposer = useCallback(async () => {
+    if (startupDraftComposerDockingRef.current || prefersReducedMotion()) {
+      return;
+    }
+
+    const fromRect = startupDraftComposerRef.current?.getBoundingClientRect() ?? null;
+    startupDraftComposerDockingRef.current = true;
+
+    flushSync(() => {
+      setStartupDraftComposerAnimation(null);
+      setStartupDraftComposerDocking(true);
+    });
+
+    const toRect = startupDraftComposerRef.current?.getBoundingClientRect() ?? null;
+    if (!fromRect || !toRect) {
+      return;
+    }
+
+    const y = Math.min(0, fromRect.top - toRect.top);
+    if (Math.abs(y) < 0.5) {
+      return;
+    }
+
+    flushSync(() => {
+      setStartupDraftComposerAnimation({ y });
+    });
+
+    await delay(STARTUP_DRAFT_COMPOSER_DOCK_MS);
+    setStartupDraftComposerAnimation(null);
+  }, []);
+
+  const resetStartupDraftComposerDocking = useCallback(() => {
+    startupDraftComposerDockingRef.current = false;
+    setStartupDraftComposerAnimation(null);
+    setStartupDraftComposerDocking(false);
+  }, []);
+
