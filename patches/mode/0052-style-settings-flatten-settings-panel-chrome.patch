Subject: [PATCH 52/53] style(settings): flatten settings panel chrome

---
 .../src/components/settings/settingsLayout.tsx    | 15 ++++++---------
 1 file changed, 6 insertions(+), 9 deletions(-)

diff --git a/apps/web/src/components/settings/settingsLayout.tsx b/apps/web/src/components/settings/settingsLayout.tsx
index 2130e069..07984091 100644
--- a/apps/web/src/components/settings/settingsLayout.tsx
+++ b/apps/web/src/components/settings/settingsLayout.tsx
@@ -34,19 +34,16 @@ export function SettingsSection({
     <section
       {...sectionProps}
       {...(anchorId ? { id: anchorId } : {})}
-      className={cn("scroll-mt-6 space-y-2.5", className)}
+      className={cn("scroll-mt-6 space-y-3", className)}
     >
       <div className="flex items-center justify-between px-1">
-        <h2 className="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-foreground/50">
-          <span className="inline-block h-px w-3 bg-border" aria-hidden />
+        <h2 className="flex items-center gap-2 text-[15px] font-semibold tracking-[-0.01em] text-foreground">
           {icon}
           {title}
         </h2>
         <div className="flex h-5 min-w-5 items-center justify-end">{headerAction}</div>
       </div>
-      <div className="relative overflow-visible rounded-2xl border bg-card text-card-foreground shadow-sm/4 not-dark:bg-clip-padding before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:shadow-none dark:before:shadow-[0_-1px_--theme(--color-white/6%)]">
-        {children}
-      </div>
+      <div>{children}</div>
     </section>
   );
 }
@@ -75,8 +72,8 @@ export function SettingsRow({
       {...rowProps}
       {...(anchorId ? { id: anchorId } : {})}
       className={cn(
-        "scroll-mt-6 border-t border-border/60 px-4 first:border-t-0 sm:px-5",
-        children ? "pt-3.5 pb-0" : "py-3.5",
+        "scroll-mt-6 border-t border-border/50 px-4 first:border-t-0 sm:px-5",
+        children ? "pt-4 pb-0" : "py-4",
         className,
       )}
     >
@@ -137,7 +134,7 @@ export function SettingsPageContainer({
 }) {
   return (
     <div className="scrollbar-gutter-both flex-1 overflow-y-auto p-6 sm:p-8">
-      <div className={cn("mx-auto flex w-full max-w-3xl flex-col gap-8", className)}>
+      <div className={cn("mx-auto flex w-full max-w-3xl flex-col gap-10", className)}>
         {children}
       </div>
     </div>
