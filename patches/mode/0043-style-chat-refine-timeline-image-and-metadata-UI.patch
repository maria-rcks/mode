+function UserMessageImageAttachmentTile(props: {
+  image: TimelineImageAttachment;
+  images: ReadonlyArray<TimelineImageAttachment>;
+}) {
+  const ctx = use(TimelineRowCtx);
+  const previewUrl = useTimelineAttachmentPreviewUrl(ctx.activeThreadEnvironmentId, props.image);
