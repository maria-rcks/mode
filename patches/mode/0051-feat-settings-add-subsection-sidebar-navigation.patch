 }
+
+function SettingsNavMenu({
+  currentHashId,
+  expandedCategories,
+  foldOverflow,
+  isMeasureOnly = false,
+  pathname,
+  onCollapseCategory,
+  onExpandCategory,
+  onNavigate,
+}: {
+  currentHashId: string;
+  expandedCategories: ReadonlySet<SettingsSectionPath>;
+  foldOverflow: boolean;
+  isMeasureOnly?: boolean;
+  pathname: string;
+  onCollapseCategory: (categoryPath: SettingsSectionPath) => void;
+  onExpandCategory: (categoryPath: SettingsSectionPath) => void;
+  onNavigate: (to: SettingsSectionPath, anchor?: string) => void;
+}) {
+  return (
+    <SidebarGroup className="gap-1 px-2 pt-1 pb-2">
+      <SidebarMenu>
+        {SETTINGS_NAV_GROUPS.map((category) => {
+          const Icon = category.icon;
+          const isCategoryCurrent = pathname === category.to;
+          const subItems = category.subItems ?? [];
+          const hasSubItems = subItems.length > 0;
+          const activeSubItem =
+            isCategoryCurrent && hasSubItems
+              ? subItems.find((sub) => sub.anchor === currentHashId)
+              : undefined;
+          const hasOverflowingSubItems = subItems.length > SETTINGS_SUBITEM_PREVIEW_COUNT;
+          const canFoldCategory = foldOverflow && hasOverflowingSubItems;
+          const isCategoryExpanded = expandedCategories.has(category.to);
+          const shouldFoldCategory = canFoldCategory && !isCategoryExpanded;
+          const renderedSubItems = shouldFoldCategory
+            ? [
+                ...subItems.slice(0, SETTINGS_SUBITEM_PREVIEW_COUNT),
+                ...(activeSubItem &&
+                !subItems
+                  .slice(0, SETTINGS_SUBITEM_PREVIEW_COUNT)
+                  .some((sub) => sub.anchor === activeSubItem.anchor)
+                  ? [activeSubItem]
+                  : []),
+              ]
+            : subItems;
+
+          return (
+            <SidebarMenuItem key={category.to}>
+              <SidebarMenuButton
+                size="sm"
+                isActive={isCategoryCurrent}
+                tabIndex={isMeasureOnly ? -1 : undefined}
+                className={cn(
+                  "gap-2 px-2 py-1.5 text-left text-xs font-medium data-[active=true]:bg-transparent data-[active=true]:text-foreground",
+                  isCategoryCurrent
+                    ? "text-foreground"
+                    : "text-muted-foreground/70 hover:text-foreground/80",
+                )}
+                onClick={isMeasureOnly ? undefined : () => onNavigate(category.to)}
+              >
+                <Icon
+                  className={
+                    isCategoryCurrent
+                      ? "size-3.5 shrink-0 text-foreground"
+                      : "size-3.5 shrink-0 text-muted-foreground/60"
+                  }
+                />
+                <span className="truncate">{category.label}</span>
+              </SidebarMenuButton>
+
+              {hasSubItems ? (
+                <SidebarMenuSub className="mx-0 my-0 w-full translate-x-0 gap-0.5 border-l-0 px-0 py-0">
+                  {renderedSubItems.map((sub) => {
+                    const isSubActive = activeSubItem?.anchor === sub.anchor;
+                    return (
+                      <SidebarMenuSubItem key={sub.anchor} className="w-full">
+                        <SidebarMenuSubButton
+                          size="sm"
+                          isActive={isSubActive}
+                          tabIndex={isMeasureOnly ? -1 : undefined}
+                          className={cn(
+                            "relative h-6 w-full translate-x-0 justify-start px-2 text-left text-xs data-[active=true]:bg-transparent data-[active=true]:text-foreground",
+                            isSubActive
+                              ? "text-foreground"
+                              : "text-muted-foreground/70 hover:text-foreground",
+                          )}
+                          onClick={
+                            isMeasureOnly ? undefined : () => onNavigate(category.to, sub.anchor)
+                          }
+                        >
+                          <span className="flex min-w-0 flex-1 items-center pl-[22px]">
+                            <span className="truncate">{sub.label}</span>
+                          </span>
+                        </SidebarMenuSubButton>
+                      </SidebarMenuSubItem>
+                    );
+                  })}
+
+                  {canFoldCategory && !isCategoryExpanded ? (
+                    <SidebarMenuSubItem className="w-full">
+                      <SidebarMenuSubButton
+                        size="sm"
+                        tabIndex={isMeasureOnly ? -1 : undefined}
+                        className="relative h-6 w-full translate-x-0 justify-start px-2 text-left text-[10px] text-muted-foreground/60 hover:bg-accent hover:text-muted-foreground/80"
+                        onClick={isMeasureOnly ? undefined : () => onExpandCategory(category.to)}
+                      >
+                        <span className="flex min-w-0 flex-1 items-center pl-[22px]">
+                          <span>Show more</span>
+                        </span>
+                      </SidebarMenuSubButton>
+                    </SidebarMenuSubItem>
+                  ) : null}
+                  {canFoldCategory && isCategoryExpanded ? (
+                    <SidebarMenuSubItem className="w-full">
+                      <SidebarMenuSubButton
+                        size="sm"
+                        tabIndex={isMeasureOnly ? -1 : undefined}
+                        className="relative h-6 w-full translate-x-0 justify-start px-2 text-left text-[10px] text-muted-foreground/60 hover:bg-accent hover:text-muted-foreground/80"
+                        onClick={isMeasureOnly ? undefined : () => onCollapseCategory(category.to)}
+                      >
+                        <span className="flex min-w-0 flex-1 items-center pl-[22px]">
+                          <span>Show less</span>
+                        </span>
+                      </SidebarMenuSubButton>
+                    </SidebarMenuSubItem>
+                  ) : null}
+                </SidebarMenuSub>
+              ) : null}
+            </SidebarMenuItem>
+          );
+        })}
+      </SidebarMenu>
+    </SidebarGroup>
+  );
+}
