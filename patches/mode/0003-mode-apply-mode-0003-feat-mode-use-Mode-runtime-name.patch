+export function createMigratingStorage(
+  baseStorage: Partial<StateStorage> | null | undefined,
+  legacyKeysByName: Readonly<Record<string, readonly string[]>>,
+): StateStorage {
+  const resolvedStorage = resolveStorage(baseStorage);
+  return {
+    getItem: (name) => {
+      const value = resolvedStorage.getItem(name);
+      if (value !== null) {
+        return value;
+      }
+
+      for (const legacyName of legacyKeysByName[name] ?? []) {
+        const legacyValue = resolvedStorage.getItem(legacyName);
+        if (typeof legacyValue !== "string") {
+          continue;
+        }
+        resolvedStorage.setItem(name, legacyValue);
+        return legacyValue;
+      }
+
+      return null;
+    },
+    setItem: (name, value) => resolvedStorage.setItem(name, value),
+    removeItem: (name) => resolvedStorage.removeItem(name),
+  };
+}
