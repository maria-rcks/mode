diff --git a/apps/web/src/components/FadingTopBar.tsx b/apps/web/src/components/FadingTopBar.tsx
new file mode 100644
index 00000000..0d330692
--- /dev/null
+++ b/apps/web/src/components/FadingTopBar.tsx
@@ -0,0 +1,51 @@
+import { type ComponentPropsWithoutRef } from "react";
+
+import { isElectron } from "../env";
+import { cn } from "../lib/utils";
+
+export function FadingTopBar({
+  children,
+  reserveTitleBarControlInset = true,
+  surface = "fade",
+  viewportFixed = false,
+  className,
+  contentClassName,
+  style,
+  ...headerProps
+}: ComponentPropsWithoutRef<"header"> & {
+  reserveTitleBarControlInset?: boolean;
+  surface?: "fade" | "transparent";
+  viewportFixed?: boolean;
+  contentClassName?: string;
+}) {
+  const fadeBackgroundImage =
+    "linear-gradient(to bottom, #191919 0%, #191919 var(--fading-topbar-solid-end), rgb(25 25 25 / 0) calc(var(--fading-topbar-solid-end) + 2rem))";
+
+  return (
+    <header
+      {...headerProps}
+      style={style}
+      className={cn(
+        "pointer-events-none right-0 top-0 z-20 [--fading-topbar-scrollbar-gutter:12px] [--fading-topbar-solid-end:43.75px]",
+        viewportFixed ? "fixed left-(--sidebar-width)" : "absolute left-0",
+        isElectron
+          ? cn(
+              "drag-region flex h-[52px] items-start px-3 pt-3 sm:px-5 [--fading-topbar-solid-end:40.5px] wco:h-[env(titlebar-area-height)]",
+              reserveTitleBarControlInset &&
+                "wco:pr-[calc(100vw-env(titlebar-area-width)-env(titlebar-area-x)+1em)]",
+            )
+          : "h-14 pl-[calc(env(safe-area-inset-left)+0.75rem)] pr-[calc(env(safe-area-inset-right)+0.75rem)] pt-2 sm:pl-[calc(env(safe-area-inset-left)+1.25rem)] sm:pr-[calc(env(safe-area-inset-right)+1.25rem)] sm:pt-3",
+        className,
+      )}
+    >
+      {surface === "fade" ? (
+        <div
+          aria-hidden="true"
+          className="pointer-events-none absolute left-0 right-[var(--fading-topbar-scrollbar-gutter)] top-0 h-[calc(var(--fading-topbar-solid-end)+2rem)]"
+          style={{ backgroundImage: fadeBackgroundImage }}
+        />
+      ) : null}
+      <div className={cn("pointer-events-auto relative w-full", contentClassName)}>{children}</div>
+    </header>
+  );
+}
