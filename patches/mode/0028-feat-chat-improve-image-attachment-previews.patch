+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vite-plus/test";
+
+import { ExpandedImageDialog } from "./ExpandedImageDialog";
+
+describe("ExpandedImageDialog", () => {
+  it("renders gallery controls without a filename caption", () => {
+    const markup = renderToStaticMarkup(
+      <ExpandedImageDialog
+        preview={{
+          index: 0,
+          images: [
+            { src: "/attachments/first.png", name: "first.png", sizeBytes: 1234 },
+            { src: "/attachments/second.png", name: "second.png", sizeBytes: 2_345_678 },
+          ],
+        }}
+        onClose={() => {}}
+      />,
+    );
+
+    expect(markup).toContain('aria-label="Previous image"');
+    expect(markup).toContain('aria-label="Next image"');
+    expect(markup).toContain('aria-label="Show image 1 of 2"');
+    expect(markup).toContain('aria-current="true"');
+    expect(markup).toContain("fixed left-4 top-1/2");
+    expect(markup).toContain("fixed right-4 top-1/2");
+    expect(markup).toContain("[perspective:1200px]");
+    expect(markup).toContain("h-[min(66vh,42rem)] w-[min(74vw,58rem)]");
+    expect(markup).toContain("absolute h-full w-full");
+    expect(markup).toContain("opacity:1");
+    expect(markup).toContain("translate(-50%, -50%) translateX(0%)");
+    expect(markup).toContain('class="h-full w-full select-none object-contain"');
+    expect(markup).toContain("first.png · 1.2 KB");
+    expect(markup).toContain("second.png · 2.2 MB");
+    expect(markup).not.toContain("fixed bottom-4");
+    expect(markup).not.toContain("bg-black/55");
+    expect(markup).not.toContain("first.png (1/2)");
+  });
+});
