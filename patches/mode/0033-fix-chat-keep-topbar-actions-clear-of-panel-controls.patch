diff --git a/apps/web/src/components/ChatView.browser.tsx b/apps/web/src/components/ChatView.browser.tsx
index 57c9b49e..a8843bf0 100644
--- a/apps/web/src/components/ChatView.browser.tsx
+++ b/apps/web/src/components/ChatView.browser.tsx
@@ -1227,6 +1227,15 @@ async function waitForElement<T extends Element>(
   return element;
 }
 
+function visibleChildrenRightEdge(element: Element): number {
+  const rightEdges = Array.from(element.children)
+    .map((child) => child.getBoundingClientRect())
+    .filter((rect) => rect.width > 0 && rect.height > 0)
+    .map((rect) => rect.right);
+  if (rightEdges.length === 0) return element.getBoundingClientRect().right;
+  return Math.max(...rightEdges);
+}
+
