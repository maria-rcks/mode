+function projectSelectValue(project: Project): string {
+  return scopedProjectKey(scopeProjectRef(project.environmentId, project.id));
+}
+
+interface BranchToolbarProjectSelectorProps {
+  activeProject: Project;
+  projects: readonly Project[] | undefined;
+  onProjectChange: ((project: Project) => void) | undefined;
+  className?: string;
+}
+
+const BranchToolbarProjectSelector = memo(function BranchToolbarProjectSelector({
+  activeProject,
+  projects,
+  onProjectChange,
+  className,
+}: BranchToolbarProjectSelectorProps) {
+  const projectOptions = projects?.length ? projects : [activeProject];
+  const value = projectSelectValue(activeProject);
+  const items = useMemo(
+    () =>
+      projectOptions.map((project) => ({
+        value: projectSelectValue(project),
+        label: project.name,
+      })),
+    [projectOptions],
+  );
+  const canChangeProject = Boolean(onProjectChange && projectOptions.length > 1);
+
+  const projectContent = (
+    <>
+      <ProjectFavicon
+        environmentId={activeProject.environmentId}
+        cwd={activeProject.cwd}
+        folderStateIcon
+        className="size-3.5"
+      />
+      <span className="min-w-0 truncate">{activeProject.name}</span>
+    </>
+  );
+
+  if (!canChangeProject) {
+    return (
+      <span
+        className={cn(
+          "inline-flex min-w-0 items-center gap-1 border border-transparent px-[calc(--spacing(2)-1px)] text-sm font-medium text-muted-foreground/70 sm:text-xs",
+          className,
+        )}
+      >
+        {projectContent}
+      </span>
+    );
+  }
+
+  return (
+    <Select
+      modal={false}
+      value={value}
+      onValueChange={(nextValue) => {
+        const nextProject = projectOptions.find(
+          (project) => projectSelectValue(project) === nextValue,
+        );
+        if (nextProject) {
+          onProjectChange?.(nextProject);
+        }
+      }}
+      items={items}
+    >
+      <SelectTrigger
+        variant="ghost"
+        size="xs"
+        className={cn("max-w-full font-medium text-muted-foreground/78", className)}
+        aria-label="Project"
+      >
+        <ProjectFavicon
+          environmentId={activeProject.environmentId}
+          cwd={activeProject.cwd}
+          folderStateIcon
+          className="size-3.5"
+        />
+        <SelectValue />
+      </SelectTrigger>
+      <SelectPopup matchTriggerWidth={false} popupClassName="w-72">
+        <SelectGroup>
+          <SelectGroupLabel>Project</SelectGroupLabel>
+          {projectOptions.map((project) => (
+            <SelectItem key={projectSelectValue(project)} value={projectSelectValue(project)}>
+              <span className="inline-flex min-w-0 items-center gap-1.5">
+                <ProjectFavicon
+                  environmentId={project.environmentId}
+                  cwd={project.cwd}
+                  folderStateIcon
+                  className="size-3.5"
+                />
+                <span className="truncate">{project.name}</span>
+              </span>
+            </SelectItem>
+          ))}
+        </SelectGroup>
+      </SelectPopup>
+    </Select>
+  );
+});
