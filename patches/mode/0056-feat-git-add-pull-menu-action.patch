   CloudUploadIcon,
+  DownloadIcon,
   ExternalLinkIcon,
   GitBranchPlusIcon,
   GitCommitIcon,
@@ -65,6 +66,7 @@ import {
   useSourceControlActionRunning,
   useSourceControlPublishRepositoryAction,
   useVcsInitAction,
+  useVcsPullAction,
 } from "~/lib/sourceControlActions";
 import { getVcsStatusDataForTarget, refreshVcsStatus, useVcsStatus } from "~/lib/vcsStatusState";
 import { useSourceControlDiscovery } from "~/lib/sourceControlDiscoveryState";
@@ -256,6 +258,25 @@ function getMenuActionDisabledReason({
     return "Commit is currently unavailable.";
   }
 
+  if (item.id === "pull") {
+    if (!hasBranch) {
+      return "Detached HEAD: checkout a refName before pulling.";
+    }
+    if (hasChanges) {
+      return "Commit or stash local changes before pulling.";
+    }
+    if (isAhead && isBehind) {
+      return "Branch has diverged from upstream. Rebase/merge first.";
+    }
+    if (!gitStatus.hasUpstream) {
+      return "Current refName has no upstream configured.";
+    }
+    if (!isBehind) {
+      return "Branch is already up to date.";
+    }
+    return "Pull is currently unavailable.";
+  }
+
   if (item.id === "push") {
     if (!hasBranch) {
       return "Detached HEAD: checkout a refName before pushing.";
@@ -308,6 +329,7 @@ function GitActionItemIcon({
   SourceControlIcon: ReturnType<typeof getSourceControlPresentation>["Icon"];
 }) {
   if (icon === "commit") return <GitCommitIcon />;
+  if (icon === "pull") return <DownloadIcon />;
   if (icon === "push") return <CloudUploadIcon />;
   return <SourceControlIcon />;
 }
@@ -1056,6 +1078,7 @@ export default function GitActionsControl({
 
   const initAction = useVcsInitAction(sourceControlScope);
   const runImmediateGitAction = useGitStackedAction(sourceControlScope);
+  const pullAction = useVcsPullAction(sourceControlScope);
   const isGitActionRunning = useSourceControlActionRunning(
     sourceControlScope,
     RUNNING_SOURCE_CONTROL_ACTIONS,
@@ -1184,6 +1207,45 @@ export default function GitActionsControl({
     });
   }, [gitStatusForActions, threadToastData]);
 
+  const runPullWithToast = useCallback(async () => {
+    const toastId = toastManager.add({
+      type: "loading",
+      title: "Pulling latest changes...",
+      description: "Waiting for Git...",
+      timeout: 0,
+      data: threadToastData,
+    });
+
+    try {
+      const result = await pullAction.run();
+      toastManager.update(toastId, {
+        type: "success",
+        title:
+          result.status === "skipped_up_to_date"
+            ? "Branch already up to date"
+            : "Pulled latest changes",
+        description: result.upstreamRef
+          ? `${result.refName} is synced with ${result.upstreamRef}.`
+          : `${result.refName} is synced with upstream.`,
+        timeout: 0,
+        data: {
+          ...threadToastData,
+          dismissAfterVisibleMs: 10_000,
+        },
+      });
+    } catch (err) {
+      toastManager.update(
+        toastId,
+        stackedThreadToast({
+          type: "error",
+          title: "Pull failed",
+          description: err instanceof Error ? err.message : "An error occurred.",
+          ...(threadToastData !== undefined ? { data: threadToastData } : {}),
+        }),
+      );
+    }
+  }, [pullAction, threadToastData]);
+
   runGitActionWithToast = useEffectEvent(
     async ({
       action,
@@ -1460,6 +1522,10 @@ export default function GitActionsControl({
 
   const openDialogForMenuItem = (item: GitActionMenuItem) => {
     if (item.disabled) return;
+    if (item.kind === "run_pull") {
+      void runPullWithToast();
+      return;
+    }
     if (item.kind === "open_pr") {
       void openExistingPr();
       return;
