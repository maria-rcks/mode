+export interface AttachmentPreviewAssetUrl {
+  readonly url: string;
+  readonly expiresAt: number;
+}
+
+export type AttachmentPreviewAssetUrlByKey = Readonly<
+  Record<string, AttachmentPreviewAssetUrl | undefined>
+>;
+
+export function attachmentPreviewAssetKey(
+  environmentId: EnvironmentId,
+  attachmentId: string,
+): string {
+  return `${environmentId}:${attachmentId}`;
+}
+
+export function collectMissingAttachmentPreviewAssetIds(input: {
+  readonly environmentId: EnvironmentId;
+  readonly messages: ReadonlyArray<ChatMessage>;
+  readonly previewUrlByKey: AttachmentPreviewAssetUrlByKey;
+}): string[] {
+  const missingAttachmentIds: string[] = [];
+  const seenAttachmentIds = new Set<string>();
+
+  for (const message of input.messages) {
+    if (message.role !== "user" || !message.attachments) {
+      continue;
+    }
+
+    for (const attachment of message.attachments) {
+      if (attachment.type !== "image" || attachment.previewUrl) {
+        continue;
+      }
+      if (seenAttachmentIds.has(attachment.id)) {
+        continue;
+      }
+      const key = attachmentPreviewAssetKey(input.environmentId, attachment.id);
+      if (input.previewUrlByKey[key]) {
+        continue;
+      }
+      seenAttachmentIds.add(attachment.id);
+      missingAttachmentIds.push(attachment.id);
+    }
+  }
+
+  return missingAttachmentIds;
+}
+
+export function applyResolvedAttachmentPreviewUrls(input: {
+  readonly environmentId: EnvironmentId;
+  readonly messages: ChatMessage[];
+  readonly previewUrlByKey: AttachmentPreviewAssetUrlByKey;
+}): ChatMessage[] {
+  let messagesChanged = false;
+
+  const messages = input.messages.map((message) => {
+    if (message.role !== "user" || !message.attachments || message.attachments.length === 0) {
+      return message;
+    }
+
+    let attachmentsChanged = false;
+    const attachments = message.attachments.map((attachment) => {
+      if (attachment.type !== "image" || attachment.previewUrl) {
+        return attachment;
+      }
+
+      const resolved =
+        input.previewUrlByKey[attachmentPreviewAssetKey(input.environmentId, attachment.id)];
+      if (!resolved) {
+        return attachment;
+      }
+
+      attachmentsChanged = true;
+      return {
+        ...attachment,
+        previewUrl: resolved.url,
+      };
+    });
+
+    if (!attachmentsChanged) {
+      return message;
+    }
+
+    messagesChanged = true;
+    return {
+      ...message,
+      attachments,
+    };
+  });
+
+  return messagesChanged ? messages : input.messages;
+}
