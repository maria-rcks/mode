+function makeImageMessage(input: {
+  id: string;
+  attachments: NonNullable<ChatMessage["attachments"]>;
+}): ChatMessage {
+  return {
+    id: MessageId.make(input.id),
+    role: "user",
+    text: "image message",
+    attachments: input.attachments,
+    createdAt: "2026-03-29T00:00:00.000Z",
+    streaming: false,
+  };
+}
+
+describe("attachment preview asset URLs", () => {
+  const imageAttachment = (input: { id: string; previewUrl?: string }) => ({
+    type: "image" as const,
+    id: input.id,
+    name: `${input.id}.png`,
+    mimeType: "image/png",
+    sizeBytes: 123,
+    ...(input.previewUrl ? { previewUrl: input.previewUrl } : {}),
+  });
+
+  it("collects missing stored user image preview IDs once", () => {
+    const messages: ChatMessage[] = [
+      makeImageMessage({
+        id: "message-1",
+        attachments: [
+          imageAttachment({ id: "attachment-1" }),
+          imageAttachment({ id: "attachment-2", previewUrl: "blob:already-visible" }),
+          imageAttachment({ id: "attachment-1" }),
+        ],
+      }),
+      {
+        id: MessageId.make("message-assistant"),
+        role: "assistant",
+        text: "ignored",
+        attachments: [imageAttachment({ id: "attachment-assistant" })],
+        createdAt: "2026-03-29T00:00:01.000Z",
+        streaming: false,
+      },
+    ];
+
+    expect(
+      collectMissingAttachmentPreviewAssetIds({
+        environmentId: localEnvironmentId,
+        messages,
+        previewUrlByKey: {},
+      }),
+    ).toEqual(["attachment-1"]);
+  });
+
+  it("skips attachments with cached preview asset URLs", () => {
+    const attachmentId = "attachment-cached";
+
+    expect(
+      collectMissingAttachmentPreviewAssetIds({
+        environmentId: localEnvironmentId,
+        messages: [
+          makeImageMessage({
+            id: "message-cached",
+            attachments: [imageAttachment({ id: attachmentId })],
+          }),
+        ],
+        previewUrlByKey: {
+          [attachmentPreviewAssetKey(localEnvironmentId, attachmentId)]: {
+            url: "http://localhost/api/assets/token/attachment-cached.png",
+            expiresAt: Date.now() + 60_000,
+          },
+        },
+      }),
+    ).toEqual([]);
+  });
+
+  it("applies resolved preview URLs without mutating server messages", () => {
+    const messages: ChatMessage[] = [
+      makeImageMessage({
+        id: "message-hydrate",
+        attachments: [imageAttachment({ id: "attachment-hydrate" })],
+      }),
+    ];
+
+    const hydrated = applyResolvedAttachmentPreviewUrls({
+      environmentId: localEnvironmentId,
+      messages,
+      previewUrlByKey: {
+        [attachmentPreviewAssetKey(localEnvironmentId, "attachment-hydrate")]: {
+          url: "http://localhost/api/assets/token/attachment-hydrate.png",
+          expiresAt: Date.now() + 60_000,
+        },
+      },
+    });
+
+    expect(hydrated).not.toBe(messages);
+    expect(hydrated[0]?.attachments?.[0]?.previewUrl).toBe(
+      "http://localhost/api/assets/token/attachment-hydrate.png",
+    );
+    expect(messages[0]?.attachments?.[0]?.previewUrl).toBeUndefined();
+  });
+
+  it("keeps existing preview URLs and preserves the message array when unchanged", () => {
