 }
 
+export function shouldShowGitDiffStats(stats: GitDiffStats | null): boolean {
+  return stats !== null && (stats.insertions > 0 || stats.deletions > 0);
+}
+
+const DIFF_STAT_SLOT_OPTIONS = {
+  bounce: 0.2,
+  duration: 120,
+  stagger: 8,
+} as const;
+
+function formatDiffStatText(prefix: "+" | "-", value: number): string {
+  return `${prefix}${value}`;
+}
+
+function AnimatedDiffStatText({
+  value,
+  prefix,
+  direction,
+  className,
+}: {
+  readonly value: number;
+  readonly prefix: "+" | "-";
+  readonly direction: "up" | "down";
+  readonly className: string;
+}) {
+  const textRef = useRef<HTMLSpanElement>(null);
+  const labelRef = useRef<ReturnType<typeof slotText> | null>(null);
+  const currentTextRef = useRef(formatDiffStatText(prefix, value));
+
+  useLayoutEffect(() => {
+    const element = textRef.current;
+    if (!element) return;
+
+    const label = slotText(element, currentTextRef.current, {
+      ...DIFF_STAT_SLOT_OPTIONS,
+      direction,
+    });
+    labelRef.current = label;
+
+    return () => {
+      labelRef.current = null;
+      label.destroy();
+    };
+  }, [direction]);
+
+  useLayoutEffect(() => {
+    const label = labelRef.current;
+    const nextText = formatDiffStatText(prefix, value);
+    if (!label || nextText === currentTextRef.current) {
+      return;
+    }
+
+    currentTextRef.current = nextText;
+    label.set(nextText, {
+      ...DIFF_STAT_SLOT_OPTIONS,
+      direction,
+    });
+  }, [direction, prefix, value]);
+
+  return <span ref={textRef} className={className} />;
+}
+
+function GitDiffToggleContent({ stats }: { readonly stats: GitDiffStats | null }) {
+  if (stats === null || !shouldShowGitDiffStats(stats)) {
+    return <DiffIcon className="size-3" />;
+  }
+
+  return (
+    <span
+      aria-hidden
+      className="flex items-baseline gap-1 font-mono text-xs font-normal tabular-nums leading-none"
+    >
+      <AnimatedDiffStatText
+        value={stats.insertions}
+        prefix="+"
+        direction="up"
+        className="inline-flex text-success"
+      />
+      <AnimatedDiffStatText
+        value={stats.deletions}
+        prefix="-"
+        direction="down"
+        className="inline-flex text-destructive"
+      />
+    </span>
+  );
+}
+
