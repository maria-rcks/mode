+        <div className="flex min-h-[72px] items-center justify-center px-2 py-3 text-center text-[11px] text-muted-foreground/70">
+          {props.image.name}
+        </div>
+      )}
+    </div>
+  );
+}
+
+function useTimelineAttachmentPreviewUrl(
+  environmentId: EnvironmentId,
+  image: TimelineImageAttachment | null,
+): string | null {
+  const [assetPreviewUrl, setAssetPreviewUrl] = useState<string | null>(null);
+  const attachmentId = image && !image.previewUrl ? image.id : null;
+
+  useEffect(() => {
+    if (!attachmentId) {
+      setAssetPreviewUrl(null);
+      return;
+    }
+
+    let cancelled = false;
+    let refreshTimer: number | null = null;
+    setAssetPreviewUrl(null);
+    const load = () => {
+      void resolveAssetUrl(environmentId, { _tag: "attachment", attachmentId })
+        .then((asset) => {
+          if (cancelled) {
+            return;
+          }
+          setAssetPreviewUrl(asset.url);
+          refreshTimer = window.setTimeout(
+            load,
+            Math.max(0, asset.expiresAt - Date.now() - ATTACHMENT_PREVIEW_REFRESH_MARGIN_MS),
+          );
+        })
+        .catch(() => {
+          if (!cancelled) {
+            setAssetPreviewUrl(null);
+          }
+        });
+    };
+    load();
+
+    return () => {
+      cancelled = true;
+      if (refreshTimer) {
+        window.clearTimeout(refreshTimer);
+      }
+    };
+  }, [attachmentId, environmentId]);
+
+  return image?.previewUrl ?? assetPreviewUrl;
+}
