+    const scheduleRefresh = (key: string, expiresAt: number) => {
+      const existingTimer = attachmentPreviewAssetUrlRefreshTimersRef.current[key];
+      if (existingTimer) {
+        clearTimeout(existingTimer);
+      }
+      const delay = Math.max(0, expiresAt - Date.now() - ATTACHMENT_PREVIEW_REFRESH_MARGIN_MS);
+      attachmentPreviewAssetUrlRefreshTimersRef.current[key] = setTimeout(() => {
+        delete attachmentPreviewAssetUrlRefreshTimersRef.current[key];
+        if (!attachmentPreviewAssetUrlMountedRef.current) {
