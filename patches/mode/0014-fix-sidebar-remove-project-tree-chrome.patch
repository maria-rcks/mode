+
+describe("formatSidebarThreadTimeLabel", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-03-09T10:30:00.000Z"));
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("omits the relative time suffix for sidebar thread listings", () => {
+    expect(formatSidebarThreadTimeLabel("2026-03-09T10:06:00.000Z")).toBe("24m");
+  });
+
+  it("keeps just now labels unchanged", () => {
+    expect(formatSidebarThreadTimeLabel("2026-03-09T10:29:45.000Z")).toBe("just now");
+  });
+});
