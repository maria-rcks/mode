   };
 });
 
+export const readImageAsset = Effect.fn("AssetAccess.readImageAsset")(function* (
+  input: AssetReadImageInput,
+) {
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const config = yield* ServerConfig;
+  const rawPath = input.path.trim();
+  const candidatePath = path.isAbsolute(rawPath) ? rawPath : path.resolve(config.cwd, rawPath);
+  const resolvedPath = yield* fileSystem
+    .realPath(candidatePath)
+    .pipe(Effect.mapError((cause) => failAccess("Image file was not found.", cause)));
+  const name = path.basename(resolvedPath);
+  const extension = path.extname(name).toLowerCase();
+  if (!SAFE_IMAGE_FILE_EXTENSIONS.has(extension)) {
+    return yield* failAccess("Only image files can be attached.");
+  }
+
+  const mimeType = Mime.getType(name)?.toLowerCase() ?? "";
+  if (!mimeType.startsWith("image/")) {
+    return yield* failAccess("Only image files can be attached.");
+  }
+
+  const info = yield* fileSystem
+    .stat(resolvedPath)
+    .pipe(Effect.mapError((cause) => failAccess("Image file was not found.", cause)));
+  if (info.type !== "File") {
+    return yield* failAccess("Image path must point to a file.");
+  }
+  const sizeBytes = Number(info.size);
+  if (sizeBytes > PROVIDER_SEND_TURN_MAX_IMAGE_BYTES) {
+    return yield* failAccess("Image file is too large.");
+  }
+
+  const bytes = yield* fileSystem
+    .readFile(resolvedPath)
+    .pipe(Effect.mapError((cause) => failAccess("Failed to read image file.", cause)));
+  const dataUrl = `data:${mimeType};base64,${Buffer.from(bytes).toString("base64")}`;
+  if (dataUrl.length > PROVIDER_SEND_TURN_MAX_IMAGE_DATA_URL_CHARS) {
+    return yield* failAccess("Encoded image data is too large.");
+  }
+
+  return {
+    path: resolvedPath,
+    name,
+    mimeType,
+    sizeBytes,
+    dataUrl,
+  };
+});
+
