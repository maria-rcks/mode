diff --git a/apps/web/src/lib/threadSort.ts b/apps/web/src/lib/threadSort.ts
index de8b22e9..7847f3e6 100644
--- a/apps/web/src/lib/threadSort.ts
+++ b/apps/web/src/lib/threadSort.ts
@@ -84,3 +84,26 @@ export function getLatestThreadForProject<
     )[0] ?? null
   );
 }
+
+export function getLatestThreadByActivity<
+  T extends Pick<Thread, "id" | "archivedAt"> & ThreadSortInput,
+>(
+  threads: readonly T[],
+  sortOrder: SidebarThreadSortOrder,
+  getLastVisitedAt?: (thread: T) => string | null | undefined,
+): T | null {
+  return (
+    threads
+      .filter((thread) => thread.archivedAt === null)
+      .toSorted((left, right) => {
+        const rightLastVisitedAt = toSortableTimestamp(getLastVisitedAt?.(right) ?? undefined);
+        const leftLastVisitedAt = toSortableTimestamp(getLastVisitedAt?.(left) ?? undefined);
+        const rightTimestamp = rightLastVisitedAt ?? getThreadSortTimestamp(right, sortOrder);
+        const leftTimestamp = leftLastVisitedAt ?? getThreadSortTimestamp(left, sortOrder);
+        const byTimestamp =
+          rightTimestamp === leftTimestamp ? 0 : rightTimestamp > leftTimestamp ? 1 : -1;
+        if (byTimestamp !== 0) return byTimestamp;
+        return right.id.localeCompare(left.id);
+      })[0] ?? null
+  );
+}
