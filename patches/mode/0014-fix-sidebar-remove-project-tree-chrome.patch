+      baseClassName,
+      "via-primary/22 to-primary/22 group-hover/menu-sub-item:via-primary/26 group-hover/menu-sub-item:to-primary/26 group-focus-within/menu-sub-item:via-primary/26 group-focus-within/menu-sub-item:to-primary/26 dark:via-primary/30 dark:to-primary/30 dark:group-hover/menu-sub-item:via-primary/36 dark:group-hover/menu-sub-item:to-primary/36 dark:group-focus-within/menu-sub-item:via-primary/36 dark:group-focus-within/menu-sub-item:to-primary/36",
+    );
