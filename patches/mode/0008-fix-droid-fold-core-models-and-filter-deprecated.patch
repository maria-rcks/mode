+  it("excludes deprecated models from the model list", () => {
+    const models = buildDroidModelsFromSdkModels([
+      sdkModel({
+        id: "gpt-5.2-codex",
+        modelId: "gpt-5.2-codex",
+        displayName: "GPT-5.2-Codex [Deprecated]",
+        shortDisplayName: "GPT-5.2-Codex [Deprecated]",
+        modelProvider: ModelProvider.OPENAI,
+        supportedReasoningEfforts: [ReasoningEffort.Medium],
+        defaultReasoningEffort: ReasoningEffort.Medium,
+        isCustom: false,
+      }),
+      sdkModel({
+        id: "gpt-5.1-codex-max",
+        modelId: "gpt-5.1-codex-max",
+        displayName: "GPT-5.1-Codex-Max [Deprecated]",
+        shortDisplayName: "GPT-5.1-Codex-Max [Deprecated]",
+        modelProvider: ModelProvider.OPENAI,
+        supportedReasoningEfforts: [ReasoningEffort.Medium],
+        defaultReasoningEffort: ReasoningEffort.Medium,
+        isCustom: false,
+      }),
+      sdkModel({
+        id: "claude-opus-4.8",
+        modelId: "claude-opus-4.8",
+        displayName: "Claude Opus 4.8",
+        shortDisplayName: "Opus 4.8",
+        modelProvider: ModelProvider.ANTHROPIC,
+        supportedReasoningEfforts: [ReasoningEffort.High],
+        defaultReasoningEffort: ReasoningEffort.High,
+        isCustom: false,
+      }),
+    ]);
+
+    expect(models.map((model) => model.slug)).toEqual(["claude-opus-4.8"]);
+  });
+
+  it("folds Droid Core models into a single grouped entry", () => {
+    const models = buildDroidModelsFromSdkModels([
+      sdkModel({
+        id: "nemotron-3-ultra",
+        modelId: "nemotron-3-ultra",
+        displayName: "Droid Core (Nemotron 3 Ultra)",
+        shortDisplayName: "Nemotron 3 Ultra",
+        modelProvider: ModelProvider.FACTORY,
+        supportedReasoningEfforts: [ReasoningEffort.Off, ReasoningEffort.High],
+        defaultReasoningEffort: ReasoningEffort.High,
+        isCustom: false,
+      }),
+      sdkModel({
+        id: "deepseek-v4-pro",
+        modelId: "deepseek-v4-pro",
+        displayName: "Droid Core (DeepSeek V4 Pro)",
+        shortDisplayName: "DeepSeek V4 Pro",
+        modelProvider: ModelProvider.FACTORY,
+        supportedReasoningEfforts: [ReasoningEffort.Off, ReasoningEffort.High],
+        defaultReasoningEffort: ReasoningEffort.High,
+        isCustom: false,
+      }),
+      sdkModel({
+        id: "minimax-m2.7",
+        modelId: "minimax-m2.7",
+        displayName: "Droid Core (MiniMax M2.7)",
+        shortDisplayName: "MiniMax M2.7",
+        modelProvider: ModelProvider.FACTORY,
+        supportedReasoningEfforts: [ReasoningEffort.High],
+        defaultReasoningEffort: ReasoningEffort.High,
+        isCustom: false,
+      }),
+      sdkModel({
+        id: "minimax-m2.5",
+        modelId: "minimax-m2.5",
+        displayName: "Droid Core (MiniMax M2.5)",
+        shortDisplayName: "MiniMax M2.5",
+        modelProvider: ModelProvider.FACTORY,
+        supportedReasoningEfforts: [ReasoningEffort.High],
+        defaultReasoningEffort: ReasoningEffort.High,
+        isCustom: false,
+      }),
+    ]);
+
+    expect(models).toHaveLength(1);
+    expect(models[0]?.slug).toBe("nemotron-3-ultra");
+    expect(models[0]?.name).toBe("Droid Core");
+
+    const variant = models[0]?.capabilities?.optionDescriptors?.find(
+      (descriptor) => descriptor.id === DROID_MODEL_VARIANT_OPTION_ID,
+    );
+    expect(variant).toMatchObject({
+      label: "Variant",
+      options: [
+        { id: "nemotron-3-ultra", label: "Nemotron 3 Ultra", isDefault: true },
+        { id: "deepseek-v4-pro", label: "DeepSeek V4 Pro" },
+        { id: "minimax-m2.7", label: "MiniMax M2.7" },
+        { id: "minimax-m2.5", label: "MiniMax M2.5" },
+      ],
+    });
+  });
+
