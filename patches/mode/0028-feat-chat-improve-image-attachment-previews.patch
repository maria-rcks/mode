+function formatImageSize(sizeBytes: number | undefined) {
+  if (typeof sizeBytes !== "number" || !Number.isFinite(sizeBytes)) {
+    return null;
+  }
+  if (sizeBytes < 1024) {
+    return `${sizeBytes} B`;
+  }
+  const units = ["KB", "MB", "GB"];
+  let value = sizeBytes / 1024;
+  let unitIndex = 0;
+  while (value >= 1024 && unitIndex < units.length - 1) {
+    value /= 1024;
+    unitIndex += 1;
+  }
+  const maximumFractionDigits = value >= 10 ? 0 : 1;
+  return `${value.toFixed(maximumFractionDigits)} ${units[unitIndex] ?? "KB"}`;
+}
+
+function formatImageMetadata(name: string, sizeBytes: number | undefined) {
+  const formattedSize = formatImageSize(sizeBytes);
+  return formattedSize ? `${name} · ${formattedSize}` : name;
+}
+
+function expandedImageDeckStyle(index: number, activeIndex: number): CSSProperties {
+  const offset = index - activeIndex;
+  const distance = Math.abs(index - activeIndex);
+  const clampedOffset = Math.max(-3, Math.min(3, offset));
+  const opacity = distance === 0 ? 1 : distance === 1 ? 0.55 : distance === 2 ? 0.28 : 0;
+  const scale = Math.max(0.68, 1 - distance * 0.12);
+
+  return {
+    left: "50%",
+    opacity,
+    pointerEvents: distance > 2 ? "none" : undefined,
+    top: "50%",
+    transform: `translate(-50%, -50%) translateX(${clampedOffset * 22}%) translateY(${distance * 8}px) scale(${scale}) rotateY(${-clampedOffset * 18}deg)`,
+    zIndex: 100 - distance,
+  };
+}
+
