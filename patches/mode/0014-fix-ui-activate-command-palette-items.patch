From 1ea0f209d0b5ef0acd29322aaedc5afdfdad4ba0 Mon Sep 17 00:00:00 2001
From: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
Date: Mon, 8 Jun 2026 04:21:08 +0000
Subject: [PATCH 14/14] fix(ui): activate command palette items

---
 apps/web/src/components/ChatView.browser.tsx         | 6 ++++++
 apps/web/src/components/CommandPaletteResults.tsx    | 2 +-
 apps/web/src/components/chat/ComposerCommandMenu.tsx | 2 +-
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/apps/web/src/components/ChatView.browser.tsx b/apps/web/src/components/ChatView.browser.tsx
index cbd5a7c5..28e77a03 100644
--- a/apps/web/src/components/ChatView.browser.tsx
+++ b/apps/web/src/components/ChatView.browser.tsx
@@ -4606,6 +4606,12 @@ describe("ChatView timeline estimator parity (full app)", () => {
       await expect
         .element(palette.getByText("New thread in Project", { exact: true }))
         .not.toBeInTheDocument();
+      await palette.getByText("Open settings", { exact: true }).click();
+      await waitForURL(
+        mounted.router,
+        (path) => path.startsWith("/settings"),
+        "Route should have changed to settings from the command palette.",
+      );
     } finally {
       await mounted.cleanup();
     }
diff --git a/apps/web/src/components/CommandPaletteResults.tsx b/apps/web/src/components/CommandPaletteResults.tsx
index 4ad08db0..e5f2d7bf 100644
--- a/apps/web/src/components/CommandPaletteResults.tsx
+++ b/apps/web/src/components/CommandPaletteResults.tsx
@@ -110,7 +110,7 @@ function CommandPaletteResultRow(props: {
       onMouseDown={(event) => {
         event.preventDefault();
       }}
-      onClick={() => {
+      onSelect={() => {
         props.onExecuteItem(props.item);
       }}
     >
diff --git a/apps/web/src/components/chat/ComposerCommandMenu.tsx b/apps/web/src/components/chat/ComposerCommandMenu.tsx
index f687ec7b..4426ff2c 100644
--- a/apps/web/src/components/chat/ComposerCommandMenu.tsx
+++ b/apps/web/src/components/chat/ComposerCommandMenu.tsx
@@ -222,7 +222,7 @@ const ComposerCommandMenuItem = memo(function ComposerCommandMenuItem(props: {
       onMouseDown={(event) => {
         event.preventDefault();
       }}
-      onClick={() => {
+      onSelect={() => {
         props.onSelect(props.item);
       }}
     >
-- 
2.34.1

