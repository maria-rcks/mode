@@ -0,0 +1,92 @@
+export type SearchableSettingsSubItem = {
+  readonly label: string;
+};
+
+export type SearchableSettingsCategory<TSubItem extends SearchableSettingsSubItem> = {
+  readonly label: string;
+  readonly subItems?: ReadonlyArray<TSubItem>;
+};
+
+export type SearchableSettingsNavSubItem = SearchableSettingsSubItem & {
+  readonly anchor: string;
+};
+
+export type SearchableSettingsNavCategory<TSubItem extends SearchableSettingsNavSubItem> =
+  SearchableSettingsCategory<TSubItem> & {
+    readonly to: string;
+  };
+
+export type FilteredSettingsCategory<
+  TCategory,
+  TSubItem extends SearchableSettingsSubItem,
+> = TCategory & {
+  readonly subItems?: ReadonlyArray<TSubItem>;
+};
+
+export function normalizeSettingsSearchQuery(query: string): string {
+  return query.trim().toLowerCase().replace(/\s+/g, " ");
+}
+
+function settingLabelMatchesQuery(label: string, normalizedQuery: string): boolean {
+  return normalizeSettingsSearchQuery(label).includes(normalizedQuery);
+}
+
+export function filterSettingsNavCategories<
+  TSubItem extends SearchableSettingsSubItem,
+  TCategory extends SearchableSettingsCategory<TSubItem>,
+>(
+  categories: ReadonlyArray<TCategory>,
+  query: string,
+): Array<FilteredSettingsCategory<TCategory, TSubItem>> {
+  const normalizedQuery = normalizeSettingsSearchQuery(query);
+  if (normalizedQuery.length === 0) {
+    return [...categories];
+  }
+
+  return categories.flatMap((category) => {
+    const subItems = category.subItems ?? [];
+    const categoryMatches = settingLabelMatchesQuery(category.label, normalizedQuery);
+    const matchingSubItems = subItems.filter((subItem) =>
+      settingLabelMatchesQuery(subItem.label, normalizedQuery),
+    );
+
+    if (!categoryMatches && matchingSubItems.length === 0) {
+      return [];
+    }
+
+    return [
+      {
+        ...category,
+        subItems: categoryMatches ? subItems : matchingSubItems,
+      },
+    ];
+  });
+}
+
+export function getFirstSettingsNavSearchTarget<
+  TSubItem extends SearchableSettingsNavSubItem,
+  TCategory extends SearchableSettingsNavCategory<TSubItem>,
+>(
+  categories: ReadonlyArray<TCategory>,
+  query: string,
+): { to: TCategory["to"]; anchor?: TSubItem["anchor"] } | null {
+  const normalizedQuery = normalizeSettingsSearchQuery(query);
+  if (normalizedQuery.length === 0) {
+    return null;
+  }
+
+  for (const category of categories) {
+    if (settingLabelMatchesQuery(category.label, normalizedQuery)) {
+      return { to: category.to };
+    }
+
+    const matchingSubItem = category.subItems?.find((subItem) =>
+      settingLabelMatchesQuery(subItem.label, normalizedQuery),
+    );
+    if (matchingSubItem) {
+      return { to: category.to, anchor: matchingSubItem.anchor };
+    }
+  }
+
+  return null;
+}
